---
import DeferredCanvas from '@/scene/DeferredCanvas';
---

<div id="sticky-stage" class="lattice-persist sticky-stage" transition:persist="rag-lattice" aria-hidden="true">
  <div id="lattice-poster-layer" class="lattice-static-bg" data-ready="false">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 340" fill="none" width="420" height="340">
      <rect width="420" height="340" rx="14" fill="#0A2A2D"/>
      <g stroke="#1C5257" stroke-width="1" stroke-dasharray="3 5">
        <line x1="20" y1="70" x2="400" y2="70"/>
        <line x1="20" y1="170" x2="400" y2="170"/>
        <line x1="20" y1="270" x2="400" y2="270"/>
      </g>
      <g stroke="#FFB547" stroke-width="1.6">
        <rect x="36" y="96" width="96" height="96"/>
        <rect x="54" y="78" width="96" height="96" stroke-opacity="0.55"/>
        <line x1="36" y1="96" x2="54" y2="78"/>
        <line x1="132" y1="96" x2="150" y2="78"/>
        <line x1="36" y1="192" x2="54" y2="174"/>
        <line x1="132" y1="192" x2="150" y2="174"/>
      </g>
      <g stroke="#F4E9D3" stroke-width="1.4" stroke-opacity="0.85">
        <rect x="162" y="130" width="96" height="96"/>
        <rect x="180" y="112" width="96" height="96" stroke-opacity="0.45"/>
        <line x1="162" y1="130" x2="180" y2="112"/>
        <line x1="258" y1="130" x2="276" y2="112"/>
        <line x1="162" y1="226" x2="180" y2="208"/>
        <line x1="258" y1="226" x2="276" y2="208"/>
      </g>
      <g stroke="#7FB8BC" stroke-width="1.4" stroke-opacity="0.85">
        <rect x="288" y="96" width="96" height="96"/>
        <rect x="306" y="78" width="96" height="96" stroke-opacity="0.45"/>
        <line x1="288" y1="96" x2="306" y2="78"/>
        <line x1="384" y1="96" x2="402" y2="78"/>
        <line x1="288" y1="192" x2="306" y2="174"/>
        <line x1="384" y1="192" x2="402" y2="174"/>
      </g>
      <line x1="148" y1="144" x2="210" y2="168" stroke="#E76F51" stroke-width="1.8" stroke-dasharray="4 4"/>
      <circle cx="148" cy="144" r="14" stroke="#E76F51" stroke-width="1.5" stroke-opacity="0.8"/>
      <circle cx="148" cy="144" r="4.5" fill="#E76F51"/>
      <circle cx="92" cy="134" r="3" fill="#FFB547"/>
      <circle cx="220" cy="166" r="3" fill="#F4E9D3"/>
      <circle cx="342" cy="136" r="3" fill="#7FB8BC"/>
    </svg>
  </div>
  <DeferredCanvas client:idle />
  <div class="stage-scrim"></div>
  <div class="hud-mobile-chip" id="hud-mobile-chip">// 00 IDLE LATTICE  k=5  cos 0.83</div>
</div>

<!-- First-launch quick SVG loader: deep blurred backdrop + 3 cubes in triangle + jumping RAG packet -->
<div id="lattice-preloader" class="preloader" transition:persist="rag-preloader" aria-hidden="true" data-done="false">
  <script is:inline>
    (function () {
      var el = document.getElementById('lattice-preloader');
      if (!el) return;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || sessionStorage.getItem('hasSeenLoader') === 'true') {
        el.setAttribute('data-done', 'true');
        el.style.display = 'none';
        document.documentElement.dataset.splashDone = 'true';
      } else {
        sessionStorage.setItem('hasSeenLoader', 'true');
        document.documentElement.dataset.splashDone = 'false';
        window.setTimeout(function () {
          el.setAttribute('data-done', 'true');
          document.documentElement.dataset.splashDone = 'true';
          window.dispatchEvent(new CustomEvent('lattice:splash-done'));
          window.setTimeout(function () {
            el.style.display = 'none';
          }, 320);
        }, 1200);
      }
    })();
  </script>
  <div class="preloader-inner">
    <svg class="preloader-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 190" width="220" height="190" fill="none">
      <!-- Triangle hop paths -->
      <path id="rag-hop-path" d="M110 42 Q 168 85 162 142 Q 110 165 58 142 Q 52 85 110 42 Z" stroke="#1C5257" stroke-width="1.2" stroke-dasharray="4 4"/>
      <!-- Top Cube: Tenant A (Amber) -->
      <g stroke="#FFB547" stroke-width="1.6" stroke-linejoin="round">
        <polygon points="110,18 134,31 110,44 86,31" fill="rgba(15,59,63,0.85)"/>
        <polygon points="86,31 110,44 110,68 86,55" fill="rgba(10,42,45,0.85)"/>
        <polygon points="134,31 110,44 110,68 134,55" fill="rgba(15,59,63,0.9)"/>
      </g>
      <!-- Bottom-Left Cube: Tenant B (Cream) -->
      <g stroke="#F4E9D3" stroke-width="1.5" stroke-linejoin="round">
        <polygon points="58,116 82,129 58,142 34,129" fill="rgba(15,59,63,0.85)"/>
        <polygon points="34,129 58,142 58,166 34,153" fill="rgba(10,42,45,0.85)"/>
        <polygon points="82,129 58,142 58,166 82,153" fill="rgba(15,59,63,0.9)"/>
      </g>
      <!-- Bottom-Right Cube: Tenant C (Mist) -->
      <g stroke="#7FB8BC" stroke-width="1.5" stroke-linejoin="round">
        <polygon points="162,116 186,129 162,142 138,129" fill="rgba(15,59,63,0.85)"/>
        <polygon points="138,129 162,142 162,166 138,153" fill="rgba(10,42,45,0.85)"/>
        <polygon points="186,129 162,142 162,166 186,153" fill="rgba(15,59,63,0.9)"/>
      </g>
      <!-- Jumping RAG canary packet (1.5x duration: 1.65s) -->
      <circle r="5" fill="#E76F51">
        <animateMotion dur="1.65s" repeatCount="indefinite" path="M110 42 Q 168 85 162 142 Q 110 165 58 142 Q 52 85 110 42 Z"/>
      </circle>
      <circle r="10" stroke="#E76F51" stroke-width="1.2" opacity="0.7">
        <animateMotion dur="1.65s" repeatCount="indefinite" path="M110 42 Q 168 85 162 142 Q 110 165 58 142 Q 52 85 110 42 Z"/>
      </circle>
    </svg>
    <span class="eyebrow" style="text-align:center;">// TENANT LATTICE</span>
  </div>
</div>

<nav class="beat-rail" aria-label="Scroll beat navigation">
  {[0, 1, 2, 3, 4, 5, 6, 7].map((b) => (
    <button
      type="button"
      class="beat-tick-btn"
      data-beat-tick={String(b)}
      data-active={b === 0 ? 'true' : 'false'}
      aria-label={`Jump to beat ${b}`}
    >
      <span class="beat-tick-bar" aria-hidden="true"></span>
    </button>
  ))}
</nav>

<aside
  id="lattice-hud"
  class="lattice-hud"
  data-visible="true"
  aria-hidden="true"
>
  <div class="hud-line">
    <span class="hud-beat" id="hud-beat">IDLE LATTICE</span>
  </div>
  <div class="hud-telemetry">
    <span>tenant: <strong id="hud-tenant">A</strong></span>
    <span>|</span>
    <span>chunks: <strong id="hud-chunks">1,800</strong></span>
    <span>|</span>
    <span>k: <strong id="hud-k">5</strong></span>
    <span>|</span>
    <span>cosine: <strong id="hud-cosine">0.83</strong></span>
    <span>|</span>
    <span>leaks: <strong id="hud-leaks" data-alert="false">0</strong></span>
  </div>
  <div class="hud-channels">
    <span class="hud-ch" id="hud-ch-answer" data-active="false">ANSWER</span>
    <span class="hud-ch" id="hud-ch-citations" data-active="false">CITATIONS</span>
    <span class="hud-ch" id="hud-ch-raw" data-active="false">RAW API</span>
  </div>
  <div class="hud-sarif" id="hud-sarif" data-visible="false">
    <span class="hud-sarif-title">SARIF 2.1.0 // FIREDAMP GATE</span>
    <span>rule: rag-cross-tenant-canary | level: error | status: sealed</span>
  </div>
</aside>

<script>
  import { sceneStore } from '@/scene/store';
  import { BEATS } from '@/scene/beats/beats';

  function bindStaticFallback() {
    const poster = document.getElementById('lattice-poster-layer');
    if (!poster) return;

    const sync = () => {
      const s = sceneStore.getState();
      const showPoster = s.tier === 'static' || s.contextLost || !s.ready;
      poster.dataset.ready = showPoster ? 'false' : 'true';
    };

    sync();
    const unsub = sceneStore.subscribe(sync);
    document.addEventListener('astro:before-swap', () => unsub(), { once: true });
  }

  function bindBeatRail() {
    const rail = document.querySelector<HTMLElement>('.beat-rail');
    if (!rail || rail.dataset.bound === 'true') return;
    rail.dataset.bound = 'true';

    const scrubToBeat = (beatIdx: number) => {
      const beat = BEATS[beatIdx];
      if (!beat) return;
      const midProgress = (beat.start + beat.end) * 0.5;
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      window.scrollTo({ top: midProgress * maxScroll, behavior: 'smooth' });
    };

    rail.querySelectorAll<HTMLButtonElement>('[data-beat-tick]').forEach((btn) => {
      btn.addEventListener('click', () => {
        scrubToBeat(Number(btn.dataset.beatTick));
      });
    });

    let dragging = false;
    const handlePointer = (e: PointerEvent) => {
      const rect = rail.getBoundingClientRect();
      const relY = Math.min(1, Math.max(0, (e.clientY - rect.top) / Math.max(1, rect.height)));
      const idx = Math.min(7, Math.floor(relY * 8));
      scrubToBeat(idx);
    };
    rail.addEventListener('pointerdown', (e) => {
      dragging = true;
      handlePointer(e);
    });
    window.addEventListener('pointermove', (e) => {
      if (dragging) handlePointer(e);
    });
    window.addEventListener('pointerup', () => {
      dragging = false;
    });
  }

  bindStaticFallback();
  bindBeatRail();
  document.addEventListener('astro:after-swap', () => {
    bindStaticFallback();
    bindBeatRail();
  });
</script>
