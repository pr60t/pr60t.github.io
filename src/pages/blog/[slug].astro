---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { PROFILE } from '@/data/profile';
import { formatDisplayDate, getAllPosts, type BlogPost } from '@/lib/blog';
import { renderPostMarkdown } from '@/lib/markdown';
import '@/styles/blog.css';

export async function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: index > 0 ? posts[index - 1] : null,
      olderPost: index < posts.length - 1 ? posts[index + 1] : null,
    },
  }));
}

interface Props {
  post: BlogPost;
  newerPost: BlogPost | null;
  olderPost: BlogPost | null;
}

const { post, newerPost, olderPost } = Astro.props;
const rendered = await renderPostMarkdown(post.body);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.dateISO,
  dateModified: post.updatedISO ?? post.dateISO,
  author: {
    '@type': 'Person',
    name: PROFILE.name,
    alternateName: PROFILE.handle,
  },
  keywords: post.tags.join(', '),
};
---

<BaseLayout
  title={`${post.title} — ${PROFILE.name}`}
  description={post.description}
  ogImage={`/og/${post.slug}.png`}
  ogType="article"
  includeKatexCss={rendered.hasMath}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class="ambient-strip" aria-hidden="true">
    TENANT LATTICE // LOG ENTRY // {post.slug.toUpperCase()}
  </div>

  <article class="post-layout" data-pagefind-body>
    <div class="post-article-surface">
      <header class="post-header">
        <a class="mono-meta" href="/blog/" style="text-decoration:none;">
          &larr; Back to log
        </a>
        <h1>{post.title}</h1>
        <div class="post-meta-row">
          <time datetime={post.dateISO}>{formatDisplayDate(post.dateISO)}</time>
          {post.updatedISO && (
            <span>Updated {formatDisplayDate(post.updatedISO)}</span>
          )}
          <span>{post.readingTimeMinutes} min read</span>
          {post.draft && <span>[DRAFT]</span>}
          <button
            type="button"
            id="share-post-btn"
            class="pill-btn"
            style="min-height:44px;"
            data-share-title={post.title}
            aria-label="Share this post"
          >
            <Icon name="external" size={16} />
            <span id="share-post-label">Share</span>
          </button>
        </div>
        {post.tags.length > 0 && (
          <div class="pill-row" style="margin-top:1rem;">
            {post.tags.map((tag) => (
              <a class="tag-chip" href={`/blog/tags/${encodeURIComponent(tag)}/`}>
                {tag}
              </a>
            ))}
          </div>
        )}
      </header>

      {rendered.headings.length > 0 && (
        <details class="toc-mobile">
          <summary>Table of contents</summary>
          <ul class="toc-list">
            {rendered.headings.map((h) => (
              <li class={`toc-item toc-item--h${h.depth}`}>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div class="prose" set:html={rendered.html} />

      <nav class="post-nav-footer" aria-label="Post navigation">
        {newerPost ? (
          <a class="post-nav-card" href={`/blog/${newerPost.slug}/`}>
            <span class="mono-meta">&larr; Newer</span>
            <div style="font-weight:700;color:var(--cream);margin-top:0.25rem;">
              {newerPost.title}
            </div>
          </a>
        ) : (
          <div />
        )}
        {olderPost ? (
          <a class="post-nav-card" href={`/blog/${olderPost.slug}/`} style="text-align:right;">
            <span class="mono-meta">Older &rarr;</span>
            <div style="font-weight:700;color:var(--cream);margin-top:0.25rem;">
              {olderPost.title}
            </div>
          </a>
        ) : (
          <div />
        )}
      </nav>
    </div>

    {rendered.headings.length > 0 && (
      <aside class="toc-desktop" aria-label="Table of contents">
        <span class="eyebrow">ON THIS PAGE</span>
        <ul class="toc-list">
          {rendered.headings.map((h) => (
            <li class={`toc-item toc-item--h${h.depth}`}>
              <a href={`#${h.id}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>

  <script>
    function initPostInteractions() {
      const bar = document.getElementById('reading-progress-bar');
      if (bar) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - window.innerHeight;
          const pct = scrollable > 0 ? Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100)) : 0;
          bar.style.width = `${pct}%`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      const shareBtn = document.getElementById('share-post-btn') as HTMLButtonElement | null;
      const shareLabel = document.getElementById('share-post-label');
      if (shareBtn && shareBtn.dataset.bound !== 'true') {
        shareBtn.dataset.bound = 'true';
        shareBtn.addEventListener('click', async () => {
          const shareData = {
            title: shareBtn.dataset.shareTitle ?? document.title,
            url: window.location.href,
          };
          if (typeof navigator.share === 'function') {
            try {
              await navigator.share(shareData);
              return;
            } catch {
              // User cancelled or fallback to clipboard
            }
          }
          try {
            await navigator.clipboard.writeText(window.location.href);
            if (shareLabel) {
              shareLabel.textContent = 'Link copied';
              setTimeout(() => { shareLabel.textContent = 'Share'; }, 1200);
            }
          } catch {
            // Ignore clipboard errors
          }
        });
      }

      document.querySelectorAll<HTMLButtonElement>('.copy-code-btn').forEach((btn) => {
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', async () => {
          const code = btn.dataset.copyCode ?? '';
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = 'Copied';
            setTimeout(() => {
              btn.textContent = 'Copy';
            }, 1500);
          } catch {
            btn.textContent = 'Failed';
          }
        });
      });

      const mermaidBlocks = document.querySelectorAll<HTMLElement>('.mermaid-block[data-mermaid]');
      if (mermaidBlocks.length > 0) {
        import('mermaid').then(async ({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            themeVariables: {
              background: '#0A2A2D',
              primaryColor: '#0F3B3F',
              primaryBorderColor: '#FFB547',
              primaryTextColor: '#F4E9D3',
              lineColor: '#7FB8BC',
              secondaryColor: '#0A2A2D',
              tertiaryColor: '#1C5257',
            },
          });
          let idx = 0;
          for (const el of mermaidBlocks) {
            const def = el.dataset.mermaid ?? '';
            if (!def) continue;
            idx += 1;
            const { svg } = await mermaid.render(`mermaid-svg-${idx}`, def);
            el.innerHTML = svg;
          }
        });
      }
    }

    initPostInteractions();
    document.addEventListener('astro:after-swap', initPostInteractions);
  </script>
</BaseLayout>
